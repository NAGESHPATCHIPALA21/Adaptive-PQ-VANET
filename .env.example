# Adaptive PQ-VANET Environment Configuration Template
# DO NOT store real production secrets in this file. Copy to .env for local use.

# Trusted Authority Master Secret Key (Used for cryptographic pseudonym derivation)
TA_MASTER_SECRET=change_this_for_local_development_replace_with_strong_random_seed

# Database Connection (SQLite default for development, PostgreSQL for production)
DATABASE_URL=sqlite:///./vanet_prototype.db

# Cryptographic Lifetimes (in seconds)
AUTH_CHALLENGE_TIMEOUT_SECONDS=60
SESSION_KEY_LIFETIME_SECONDS=3600
GSK_DEFAULT_LIFETIME_SECONDS=7200

# Server Host & Port Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
